FROM apache/airflow:2.10.5-python3.11

USER root

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

USER airflow

RUN pip install --no-cache-dir \
    "snowflake-connector-python>=3.12,<5" \
    "python-dotenv>=1,<2" \
    "dbt-core==1.12.7" \
    "dbt-snowflake==1.12.5"